@model IEnumerable<DistriHub.Models.ProductDetails>
@{
    ViewData["Title"] = "Product Details";
    var serial = (string?)ViewData["Serial"] ?? string.Empty;
}
       
@section Styles {
    <link rel="stylesheet" href="~/css/serial.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <style>
        /* Responsive stacked layout for non-DataTable tables only. DataTables (dt-responsive) handles its own responsive behavior. */
        @@media (max-width: 767.98px) {
            /* Apply only to tables that are NOT using DataTables responsive (dt-responsive) */
            .table-responsive table:not(.dt-responsive) thead { display: none; }
            .table-responsive table:not(.dt-responsive), .table-responsive table:not(.dt-responsive) tbody, .table-responsive table:not(.dt-responsive) tr, .table-responsive table:not(.dt-responsive) td {
                display: block;
                width: 100%;
            }
            .table-responsive table:not(.dt-responsive) tr { margin-bottom: 1rem; border: 1px solid #e9ecef; padding: .5rem; }
            .table-responsive table:not(.dt-responsive) td {
                text-align: left;
                padding-left: 50%;
                position: relative;
                white-space: normal;
            }
            .table-responsive table:not(.dt-responsive) td::before {
                content: attr(data-label);
                position: absolute;
                left: .75rem;
                top: .5rem;
                font-weight: 600;
                width: 45%;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }
            /* Ensure DataTables child-row (dtr-details) labels and values are left aligned to override inherited centering */
            .dtr-details th {
                width: 40%;
                padding: .75rem .5rem;
                font-weight: 700;
                text-align: left !important;
                vertical-align: top;
                white-space: normal;
            }
            .dtr-details td {
                width: 60%;
                padding: .75rem .5rem;
                vertical-align: top;
                white-space: normal;
                text-align: left !important;
            }
    </style>
}

<section class="tab-components">
    <div class="container-fluid">
        <div class="title-wrapper pt-30">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="title">
                        <h2>Product Details</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-elements-wrapper">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card-style mb-30">
                        <div class="table-responsive">
                            <div class="mb-3 d-flex align-items-center">
                                @* <label for="serialFilter" class="me-2 mb-0">Serial:</label>
                                <input id="serialFilter" class="form-control form-control-sm me-2" style="max-width:300px;" value="@ViewData["Serial"]" />
                                <button id="btnFilter" class="btn btn-sm btn-primary">Filter</button>
                                <button id="btnClear" class="btn btn-sm btn-secondary ms-2">Clear</button> *@
                            </div>
                            <table id="productTable" class="table table-striped table-hover align-middle dt-responsive nowrap" style="width:100%">
                                <thead class="table-light">
                                    <tr class="text-center">
                                        @* <th scope="col">ProductId</th> *@
                                        <th scope="col">Serial No</th>
                                        <th scope="col">Category Name</th>
                                        <th scope="col">Sub Category Name</th>
                                        <th scope="col">Model Name</th>
                                        @* <th scope="col">Upload Date</th> *@
                                        <th scope="col">Is Used Display</th>
                                        <th scope="col">Distributor</th>
                                        <th scope="col">Dealer</th>
                                        <th scope="col">Finance</th>
                                        <th scope="col">FinanceDate</th>
                                        <th scope="col">Installation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* DataTable will populate rows via AJAX *@
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <!-- JSZip for excelHtml5 export. Use a reliable CDN without integrity to avoid mismatched hash errors in some environments -->
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>
    <script>
        $(document).ready(function () {
            var table = $('#productTable').DataTable({
                // show length menu, buttons, filter, table
                dom: 'lBfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Export to Excel',
                        titleAttr: 'Export to Excel',
                        filename: 'ProductDetails',
                        exportOptions: {
                            columns: ':visible',
                            modifier: {
                                // When serverSide is true, export will only include rows currently loaded on client.
                                // Set to 'all' if you want to export unfiltered server data (requires server support).
                                search: 'applied',
                                order: 'applied'
                            }
                        }
                    }
                ],
                // Use DataTables Responsive and allow horizontal scrolling on small screens
                responsive: true,
                // horizontal scrolling to allow wide tables on small devices
                scrollX: true,
                autoWidth: false,
                processing: true,
                serverSide: true,
                deferRender: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
                language: { lengthMenu: 'Show _MENU_ entries' },
                searching: true,
                ordering: true,
                ajax: {
                    url: '/SerialNoView/ApiGetProductDetails',
                    type: 'POST',
                    dataSrc: 'data',
                    data: function (d) { d.serial = $('#serialFilter').val(); }
                },
                columns: [
                    { data: 'serialNo', title: 'Serial No' },
                    { data: 'categoryName', title: 'Category Name' },
                    { data: 'subCategoryName', title: 'Sub Category Name' },
                    { data: 'modelName', title: 'Model Name' },
                    { data: 'isUsedDisplay', title: 'Is Used Display' },
                    { data: 'distributor', title: 'Distributor' },
                    { data: 'dealer', title: 'Dealer' },
                    { data: 'finance', title: 'Finance' },
                    { data: 'financeDate', title: 'FinanceDate', render: function (data) { return data ? data.substring(0, 10) : ''; } },
                    { data: 'installation', title: 'Installation' }
                ],
                columnDefs: [
                    // Align all table cells left for better mobile display
                    { targets: '_all', className: 'text-start' },
                    { targets: 0, responsivePriority: 1 },
                    { targets: 3, responsivePriority: 2 },
                    { targets: 1, responsivePriority: 3 },
                    { targets: 2, responsivePriority: 4 },
                    { targets: 4, responsivePriority: 5 },
                    { targets: 5, responsivePriority: 6 },
                    { targets: 6, responsivePriority: 7 },
                    { targets: 7, responsivePriority: 8 },
                    { targets: 8, responsivePriority: 9 },
                    { targets: 9, responsivePriority: 10 }
                ]
            });
        });
    </script>
}
